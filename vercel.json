{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/schedules/dispatch-notifications/route.ts": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "superadmin-whatsapp-notifications": {
      "schedule": "*/15 * * * *",
      "timezone": "Asia/Jakarta",
      "function": "api/schedules/dispatch-notifications"
    }
  }
}
